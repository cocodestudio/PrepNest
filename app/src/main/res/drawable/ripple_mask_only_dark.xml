<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gray_ripple">

    <!-- This is the mask shape for the ripple -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFF" /> <!-- Color is ignored, used only for shape -->
        </shape>
    </item>

    <!-- No <item> for background, means it's transparent -->
</ripple>