<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/line"
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:padding="8dp"
            android:orientation="horizontal"
            android:layout_centerHorizontal="true" />

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/filter_title"
            android:textSize="15sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/bold"
            android:layout_below="@id/line"
            android:layout_centerHorizontal="true" />

        <TextView
            android:id="@+id/sort_by_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/filter_by_date_title"
            android:textSize="12sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:layout_below="@id/sheet_title" />

        <TextView
            android:id="@+id/date_sort_recent_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="20dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/date_sort_recent"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:layout_below="@id/sort_by_date_title" />

        <TextView
            android:id="@+id/date_sort_old_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/date_sort_old"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:layout_below="@id/sort_by_date_title"
            android:layout_toRightOf="@id/date_sort_recent_txt" />

        <TextView
            android:id="@+id/sort_by_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/filter_by_type_title"
            android:textSize="12sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:layout_below="@id/date_sort_recent_txt" />

        <TextView
            android:id="@+id/type_sort_sem_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="20dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/hint_semester"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:layout_below="@id/sort_by_type_title" />

        <TextView
            android:id="@+id/type_sort_mid_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/type_sort_mid"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:layout_below="@id/sort_by_type_title"
            android:layout_toRightOf="@id/type_sort_sem_txt" />

        <TextView
            android:id="@+id/type_sort_both_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/type_sort_both"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:layout_below="@id/sort_by_type_title"
            android:layout_toRightOf="@id/type_sort_mid_txt" />

        <TextView
            android:id="@+id/sort_by_rating_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/filter_by_rating_title"
            android:textSize="12sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:visibility="gone"
            android:layout_below="@id/type_sort_sem_txt" />

        <TextView
            android:id="@+id/rating_sort_high_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/rating_sort_high"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:visibility="gone"
            android:layout_below="@id/sort_by_rating_title" />

        <TextView
            android:id="@+id/rating_sort_low_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="@string/rating_sort_low"
            android:textSize="10sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:visibility="gone"
            android:layout_below="@id/sort_by_rating_title"
            android:layout_toRightOf="@id/rating_sort_high_txt" />

        <TextView
            android:id="@+id/btn_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:paddingLeft="15dp"
            android:paddingTop="8dp"
            android:paddingRight="15dp"
            android:paddingBottom="8dp"
            android:background="#000000"
            android:text="Apply Filters"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:layout_below="@id/rating_sort_high_txt"
            android:layout_alignParentRight="true" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="10dp"
            android:paddingLeft="15dp"
            android:paddingTop="8dp"
            android:paddingRight="15dp"
            android:paddingBottom="8dp"
            android:background="#F5F5F5"
            android:text="Reset All"
            android:textSize="12sp"
            android:textColor="#000000"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:layout_below="@id/rating_sort_high_txt"
            android:layout_toLeftOf="@id/btn_apply" />
    </RelativeLayout>
</LinearLayout>
