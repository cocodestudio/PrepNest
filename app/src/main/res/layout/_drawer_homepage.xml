<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/profile_container"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:background="#FAFAFA"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/user_profile_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_image"
                app:civ_border_width="0dp"
                app:civ_border_color="#008DCD"
                app:civ_circle_background_color="#FFFFFF"
                app:civ_border_overlay="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/default_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textSize="25sp"
                android:textColor="#000000"
                android:fontFamily="@font/semibold" />
        </LinearLayout>

        <TextView
            android:id="@+id/user_name_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:textSize="18sp"
            android:textColor="#000000"
            android:fontFamily="@font/semibold" />

        <LinearLayout
            android:id="@+id/profile_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profile_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_user"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/my_profile_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/my_profile"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/my_resources_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/my_resources_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_resources"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/my_resources_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/my_resources"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wishlist_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wishlist_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_heart_filled"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wishlist_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/wishlist"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/become_provider_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/become_provider_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_star"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/become_provider_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/become_a_provider"
                android:textSize="12sp"
                android:textColor="#000000"
                android:layout_weight="1"
                android:fontFamily="@font/medium" />

            <ImageView
                android:id="@+id/provider_pending_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="3dp"
                android:src="@drawable/icon_pending"
                android:scaleType="fitCenter"
                app:tint="#9E9E9E" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upload_resource_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/upload_resource_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_upload"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/upload_resource_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/upload_a_resource"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/my_uploaded_resources_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/my_uploaded_resources_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_uploaded_resources"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/my_uploaded_resources_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/my_uploaded_resources"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/refer_and_earn_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/refer_and_earn_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_share"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/refer_and_earn_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/refer_and_earn"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/report_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <ImageView
                android:id="@+id/report_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_error"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/report_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/report_a_issue"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/faqs_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_faqs"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_help"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/faqs_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/faqs"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ghost_linear"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="8dp"
            android:orientation="horizontal"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/logout_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logout_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:padding="3dp"
                android:src="@drawable/icon_logout"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/logout_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:text="@string/logout"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
