<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/line"
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:padding="8dp"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sheet_line_indicator" />

        <TextView
            android:id="@+id/title"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Eligibility issues"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/bold" />

        <LinearLayout
            android:id="@+id/profile_eligibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_status_profile"
                android:focusable="false"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="10dp"
                android:padding="2dp"
                android:src="@drawable/icon_check_circle_round"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/profile_status_txt"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/email_eligibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_status_email"
                android:focusable="false"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="10dp"
                android:padding="2dp"
                android:src="@drawable/icon_check_circle_round"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/email_status_txt"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_eligibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_status_phone"
                android:focusable="false"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="10dp"
                android:padding="2dp"
                android:src="@drawable/icon_check_circle_round"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/phone_status_txt"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_fix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/ripple_bg_black">

            <TextView
                android:id="@+id/btn_fix_txt"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@android:color/transparent"
                android:text="Fix now"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
