<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="22dp"
                android:padding="6dp"
                android:src="@drawable/icon_back"
                android:scaleType="fitCenter"
                android:rotation="180" />

            <TextView
                android:id="@+id/ghost_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:gravity="center_horizontal|center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/coin_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:background="#FAFAFA"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/coin_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_coin_colour"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/coins_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coins"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_weight="1"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/coin_amount_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 coins"
                android:textSize="16sp"
                android:textColor="#000000"
                android:fontFamily="@font/semibold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cash_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:background="#FAFAFA"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cash_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_wallet_colour"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/cash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cash"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_weight="1"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/cash_amount_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 100"
                android:textSize="16sp"
                android:textColor="#000000"
                android:fontFamily="@font/semibold" />
        </LinearLayout>

        <TextView
            android:id="@+id/coin_conversion_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="5 coins = ₹1"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/semibold" />

        <LinearLayout
            android:id="@+id/add_cash_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:background="#FAFAFA"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/add_cash_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="15dp"
                android:padding="2dp"
                android:src="@drawable/icon_add"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/add_cash_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="Add cash"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/payout_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:background="#FAFAFA"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/payout_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="15dp"
                android:padding="2dp"
                android:src="@drawable/icon_upload"
                android:scaleType="fitCenter"
                android:rotation="90" />

            <TextView
                android:id="@+id/payout_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="Request payout"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/history_op"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:background="#FAFAFA"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/history_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="15dp"
                android:padding="2dp"
                android:src="@drawable/icon_history"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/history_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="Transaction history"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
