<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="22dp"
                android:padding="6dp"
                android:src="@drawable/icon_back"
                android:scaleType="fitCenter"
                android:rotation="180" />

            <TextView
                android:id="@+id/ghost_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:gravity="center_horizontal|center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ghost_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="horizontal"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:src="@drawable/refer_and_earn_illus"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/texts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/refer_and_earn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Refer and earn"
                android:textSize="18sp"
                android:textColor="#000000"
                android:fontFamily="@font/bold" />

            <TextView
                android:id="@+id/refer_and_earn_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="50dp"
                android:paddingRight="50dp"
                android:gravity="center_horizontal"
                android:text="Both of you will be rewarded after a successful referral — you'll receive 50 coins, and your friend will get 10 coins when they purchase their first resource item."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <LinearLayout
                android:id="@+id/total_referred_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/total_referred_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total reffered users"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/semibold" />

                <TextView
                    android:id="@+id/total_referred_amount_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/refer_code_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/refer_code_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:background="#FAFAFA"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/refer_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="35dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="35dp"
                        android:layout_marginBottom="10dp"
                        android:text="1234567"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/semibold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tap_to_copy_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_copy"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/medium" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:paddingBottom="20dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/refer_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/ripple_bg_black">

                <TextView
                    android:id="@+id/refer_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:background="@android:color/transparent"
                    android:text="Refer now"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
