<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="false"
    app:statusBarScrim="@android:color/white"
    tools:openDrawer="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/menu_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="22dp"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_menu" />

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/semibold"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/home"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/cash_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="#FAFAFA"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="15dp"
                    android:paddingTop="5dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/cash_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="5dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_cash" />

                    <TextView
                        android:id="@+id/cash_amount_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:translationY="1.0dp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/cash_progressbar"
                        style="?android:progressBarStyle"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:indeterminate="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/streak_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="#FAFAFA"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="15dp"
                    android:paddingTop="5dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/fire_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:layout_marginEnd="5dp"
                        android:text="🔥"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:translationY="1.0dp"
                        android:visibility="visible"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/streaks_amount_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:translationY="1.0dp"
                        android:visibility="visible" />

                    <ProgressBar
                        android:id="@+id/streaks_progressbar"
                        style="?android:progressBarStyle"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:indeterminate="false"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/main_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/banners_container"
                        android:layout_width="match_parent"
                        android:layout_height="230dp"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_horizontal|center_vertical"
                        android:orientation="horizontal">

                        <androidx.viewpager.widget.ViewPager
                            android:id="@+id/banner_viewpager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/banners_progressbar"
                            style="?android:progressBarStyle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:indeterminate="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recently_added_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/recently_added_title_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/recently_added_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/medium"
                                android:text="@string/recently_added"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/btn_view_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/ripple_mask_only_light"
                                android:fontFamily="@font/semibold"
                                android:paddingLeft="10dp"
                                android:paddingTop="8dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="8dp"
                                android:text="@string/view_all"
                                android:textColor="#000000"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recent_items_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmerView1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/shimmerrecyclerview1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <LinearLayout
                                android:id="@+id/recent_real_items_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/no_recent_resources_message"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/medium"
                                    android:text="@string/no_resources_here_to_show"
                                    android:textColor="#9E9E9E"
                                    android:textSize="12sp" />

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recently_added_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recommended_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/recommended_title_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingEnd="15dp">

                            <TextView
                                android:id="@+id/recommended_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/medium"
                                android:text="@string/recommended_for_you"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/see_more_icon_1"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:rotation="270"
                                android:scaleType="fitCenter"
                                android:src="@drawable/icon_down_arrow" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recommended_items_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmerView2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/shimmerrecyclerview2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <LinearLayout
                                android:id="@+id/recommended_real_items_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/no_recommended_resources_message"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/medium"
                                    android:text="@string/no_resources_here_to_show"
                                    android:textColor="#9E9E9E"
                                    android:textSize="12sp" />

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recommended_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/best_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/best_title_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingEnd="15dp">

                            <TextView
                                android:id="@+id/best_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/medium"
                                android:text="@string/best_for_you"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/see_more_icon_2"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:rotation="270"
                                android:scaleType="fitCenter"
                                android:src="@drawable/icon_down_arrow" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/best_items_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmerView3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/shimmerrecyclerview3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <LinearLayout
                                android:id="@+id/best_real_items_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/no_best_resources_message"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/medium"
                                    android:text="@string/no_resources_here_to_show"
                                    android:textColor="#9E9E9E"
                                    android:textSize="12sp" />

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/best_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.gms.ads.AdView
                        android:id="@+id/adView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:adSize="BANNER"
                        app:adUnitId="ca-app-pub-6822640863224398/6145918205"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer_layout_nav_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <include
            android:id="@+id/drawer"
            layout="@layout/_drawer_homepage" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
