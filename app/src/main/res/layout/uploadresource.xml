<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="10dp"
            android:padding="6dp"
            android:src="@drawable/icon_back"
            android:scaleType="fitCenter"
            android:rotation="180" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:gravity="center_horizontal|center_vertical"
            android:text="Upload a paper"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_weight="1"
            android:fontFamily="@font/semibold" />

        <ImageView
            android:id="@+id/guidance_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="20dp"
            android:padding="6dp"
            android:src="@drawable/icon_help"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:layout_weight="1">

        <EditText
            android:id="@+id/subject_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:paddingLeft="10dp"
            android:paddingTop="12dp"
            android:paddingRight="10dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:textSize="12sp"
            android:textColor="#000000"
            android:hint="Subject"
            android:textColorHint="#9E9E9E"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:fontFamily="@font/semibold"
            android:inputType="textCapWords"
            android:background="@drawable/rounded_shape_gray" />

        <TextView
            android:id="@+id/subject_error_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="3dp"
            android:text="Enter your subject"
            android:textSize="10sp"
            android:textColor="#000000"
            android:fontFamily="@font/medium"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/other_details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/course_select_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:background="@drawable/ripple_bg_gray">

                <TextView
                    android:id="@+id/course_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/hint_courses"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_weight="1"
                    android:fontFamily="@font/semibold" />

                <ImageView
                    android:id="@+id/down_arrow_icon_1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/icon_down_arrow"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/semester_select_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:background="@drawable/ripple_bg_gray">

                <TextView
                    android:id="@+id/semester_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/hint_semester"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_weight="1"
                    android:fontFamily="@font/semibold" />

                <ImageView
                    android:id="@+id/down_arrow_icon_2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/icon_down_arrow"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/session_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/ripple_bg_gray">

            <TextView
                android:id="@+id/session_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Session"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:layout_weight="1"
                android:fontFamily="@font/semibold" />

            <ImageView
                android:id="@+id/down_arrow_icon_4"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/icon_down_arrow"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/session_error_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="3dp"
            android:text="Select the session"
            android:textSize="10sp"
            android:textColor="#000000"
            android:fontFamily="@font/medium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pyq_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:text="@string/pyq_type_title"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/semibold" />

        <RadioGroup
            android:id="@+id/pyq_type_radiogroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/semester_pyq_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="@string/hint_semester"
                android:textSize="12sp"
                android:textColor="#000000"
                android:checked="true"
                android:fontFamily="@font/medium" />

            <RadioButton
                android:id="@+id/midterm_pyq_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="@string/type_sort_mid"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </RadioGroup>

        <TextView
            android:id="@+id/midterm_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="5dp"
            android:text="@string/midterm_type_title"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/semibold"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/midterm_type_radiogroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/midterm_1_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="1st"
                android:textSize="12sp"
                android:textColor="#000000"
                android:checked="true"
                android:fontFamily="@font/medium" />

            <RadioButton
                android:id="@+id/midterm_2_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="2nd"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />

            <RadioButton
                android:id="@+id/midterm_3_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="3rd"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </RadioGroup>

        <TextView
            android:id="@+id/price_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/select_price_note"
            android:textSize="10sp"
            android:textColor="#000000"
            android:fontFamily="@font/medium"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/attach_files_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/attach_files_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attach files"
                android:textSize="12sp"
                android:textColor="#000000"
                android:layout_weight="1"
                android:fontFamily="@font/semibold" />

            <ImageView
                android:id="@+id/icon_add_files"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:padding="8dp"
                android:src="@drawable/icon_add"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/files_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/upload_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/ripple_bg_black">

            <TextView
                android:id="@+id/btn_upload_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@android:color/transparent"
                android:text="Upload"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
