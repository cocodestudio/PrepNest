<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:padding="6dp"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_back" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/semibold"
            android:gravity="center_horizontal|center_vertical"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/upload_a_paper"
            android:textColor="#000000"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/guidance_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_help" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <EditText
            android:id="@+id/subject_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/rounded_shape_gray"
            android:fontFamily="@font/semibold"
            android:gravity="center_vertical"
            android:hint="@string/subject"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:paddingLeft="10dp"
            android:paddingTop="12dp"
            android:paddingRight="10dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="#000000"
            android:textColorHint="#9E9E9E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/subject_error_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/medium"
            android:text="@string/enter_your_subject"
            android:textColor="#000000"
            android:textSize="10sp"
            android:visibility="gone"
            tools:ignore="SmallSp" />

        <LinearLayout
            android:id="@+id/other_details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/course_select_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ripple_bg_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/course_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/semibold"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/hint_courses"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    tools:ignore="NestedWeights" />

                <ImageView
                    android:id="@+id/down_arrow_icon_1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_down_arrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/semester_select_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_bg_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/semester_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/semibold"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/hint_semester"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    tools:ignore="NestedWeights" />

                <ImageView
                    android:id="@+id/down_arrow_icon_2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_down_arrow" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/session_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/ripple_bg_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/session_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/semibold"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/session"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/down_arrow_icon_4"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_down_arrow" />
        </LinearLayout>

        <TextView
            android:id="@+id/session_error_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/medium"
            android:text="@string/select_the_session"
            android:textColor="#000000"
            android:textSize="10sp"
            android:visibility="gone"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/pyq_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/semibold"
            android:text="@string/pyq_type_title"
            android:textColor="#000000"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/pyq_type_radiogroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/semester_pyq_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/hint_semester"
                android:textColor="#000000"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/midterm_pyq_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/type_sort_mid"
                android:textColor="#000000"
                android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/midterm_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/semibold"
            android:text="@string/midterm_type_title"
            android:textColor="#000000"
            android:textSize="12sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/midterm_type_radiogroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/midterm_1_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/_1st"
                android:textColor="#000000"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/midterm_2_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/_2nd"
                android:textColor="#000000"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/midterm_3_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/_3rd"
                android:textColor="#000000"
                android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/price_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/medium"
            android:text="@string/select_price_note"
            android:textColor="#000000"
            android:textSize="10sp"
            android:visibility="gone"
            tools:ignore="SmallSp" />

        <LinearLayout
            android:id="@+id/attach_files_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/attach_files_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/semibold"
                android:text="@string/attach_files"
                android:textColor="#000000"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/icon_add_files"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_add" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/files_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/gap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            tools:ignore="NestedWeights" />

        <LinearLayout
            android:id="@+id/upload_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/ripple_bg_black"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_upload_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/bold"
                android:text="@string/upload"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
