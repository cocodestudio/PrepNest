<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/line"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/sheet_line_indicator"
        android:orientation="horizontal"
        android:padding="8dp" />

    <TextView
        android:id="@+id/request_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="30dp"
        android:focusable="false"
        android:fontFamily="@font/bold"
        android:text="@string/request_payout"
        android:textColor="#000000"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/amount_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:background="@drawable/rounded_shape_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rupee_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="10dp"
            android:focusable="false"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_cash" />

        <EditText
            android:id="@+id/amount_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:gravity="center_vertical"
            android:hint="@string/hint_amount"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="numberSigned"
            android:paddingLeft="10dp"
            android:paddingTop="12dp"
            android:paddingRight="10dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="#000000"
            android:textColorHint="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/other_money_op_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="0dp">

        <LinearLayout
            android:id="@+id/amount_1_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="#FAFAFA"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:paddingTop="5dp"
            android:paddingRight="15dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/cash_icon_1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_cash" />

            <TextView
                android:id="@+id/amount_txt_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/medium"
                android:text="30"
                android:textColor="#000000"
                android:textSize="12sp"
                android:translationY="1.0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/amount_2_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="#FAFAFA"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:paddingTop="5dp"
            android:paddingRight="15dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/cash_icon_2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_cash" />

            <TextView
                android:id="@+id/amount_txt_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/medium"
                android:text="50"
                android:textColor="#000000"
                android:textSize="12sp"
                android:translationY="1.0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/amount_3_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:paddingTop="5dp"
            android:paddingRight="15dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/cash_icon_3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_cash" />

            <TextView
                android:id="@+id/amount_txt_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/medium"
                android:text="100"
                android:textColor="#000000"
                android:textSize="12sp"
                android:translationY="1.0dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/send_req_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/ripple_bg_black"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/send_req_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:fontFamily="@font/bold"
            android:text="@string/send_request"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:focusable="false"
        android:fontFamily="@font/medium"
        android:paddingStart="15dp"
        android:paddingEnd="70dp"
        android:text="@string/request_payout_note"
        android:textColor="#000000"
        android:textSize="10sp"
        tools:ignore="SmallSp" />
</LinearLayout>