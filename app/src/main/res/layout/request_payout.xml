<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/line"
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:padding="8dp"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sheet_line_indicator" />

        <TextView
            android:id="@+id/request_title"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="Request Payout"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/bold" />

        <LinearLayout
            android:id="@+id/amount_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/rounded_shape_gray">

            <ImageView
                android:id="@+id/rupee_icon"
                android:focusable="false"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/icon_cash"
                android:scaleType="fitCenter" />

            <EditText
                android:id="@+id/amount_edittext"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="12dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:textSize="12sp"
                android:textColor="#000000"
                android:hint="@string/hint_amount"
                android:textColorHint="#9E9E9E"
                android:singleLine="true"
                android:inputType="numberSigned"
                android:imeOptions="actionDone"
                android:layout_weight="1"
                android:fontFamily="@font/semibold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/other_money_op_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:paddingLeft="15dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/amount_1_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:background="#FAFAFA"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cash_icon_1"
                    android:focusable="false"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/icon_cash"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/amount_txt_1"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:translationY="1.0dp"
                    android:fontFamily="@font/medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/amount_2_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:background="#FAFAFA"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cash_icon_2"
                    android:focusable="false"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/icon_cash"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/amount_txt_2"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:translationY="1.0dp"
                    android:fontFamily="@font/medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/amount_3_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:background="#FAFAFA"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cash_icon_3"
                    android:focusable="false"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/icon_cash"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/amount_txt_3"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:translationY="1.0dp"
                    android:fontFamily="@font/medium" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/send_req_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/ripple_bg_black">

            <TextView
                android:id="@+id/send_req_txt"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@android:color/transparent"
                android:text="@string/send_request"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/note"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:paddingLeft="15dp"
            android:paddingRight="70dp"
            android:text="Note: The amount will be credited to your account once the request is verified (usually within 1-2 days)."
            android:textSize="10sp"
            android:textColor="#000000"
            android:fontFamily="@font/medium" />
    </LinearLayout>
</LinearLayout>
