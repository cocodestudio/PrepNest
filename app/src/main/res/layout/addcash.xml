<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="22dp"
                android:padding="6dp"
                android:src="@drawable/icon_back"
                android:scaleType="fitCenter"
                android:rotation="180" />

            <TextView
                android:id="@+id/ghost_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:gravity="center_horizontal|center_vertical"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/how_to_add_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="How to add cash\?"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/bold" />

            <TextView
                android:id="@+id/step_1_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:paddingLeft="20dp"
                android:paddingRight="70dp"
                android:text="Step 1 - Use any UPI-enabled app (e.g., Google Pay, PhonePe, Paytm) to scan the QR code shown below."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <ImageView
                android:id="@+id/qrCode"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="15dp"
                android:src="@drawable/default_image"
                android:scaleType="fitCenter"
                android:layout_gravity="center_horizontal"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/step_2_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:paddingLeft="20dp"
                android:paddingRight="70dp"
                android:text="Step 2 - Make the payment using your preferred UPI app."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/step_3_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:paddingLeft="20dp"
                android:paddingRight="70dp"
                android:text="Step 3 - After a successful transaction, take a screenshot of the payment confirmation."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/step_4_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:paddingLeft="20dp"
                android:paddingRight="70dp"
                android:text="Step 4 - Upload the screenshot in the section below to submit your payment for verification."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/minimum_amount_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:paddingLeft="20dp"
                android:paddingRight="70dp"
                android:text="Minimum amount could be added is ₹10."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <LinearLayout
                android:id="@+id/ss_attach_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:padding="10dp"
                android:background="#FAFAFA"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/attach_ss_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attach Screenshot"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/semibold" />

                <LinearLayout
                    android:id="@+id/ss_file_name_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ss_file_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="Select screenshot"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/medium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ghost_linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/send_req_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/ripple_bg_black">

                <TextView
                    android:id="@+id/send_req_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:background="@android:color/transparent"
                    android:text="@string/send_request"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:paddingLeft="30dp"
                android:paddingRight="70dp"
                android:text="Note: Your account will be updated once the payment is verified (usually within 1-2 days)."
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
