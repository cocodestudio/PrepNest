<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/upper_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="30dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/signup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_signup"
                android:textSize="30sp"
                android:textColor="#000000"
                android:fontFamily="@font/bold" />

            <TextView
                android:id="@+id/signup_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="150dp"
                android:text="@string/sign_up_subtext"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:translationY="-5.0dp"
                android:fontFamily="@font/semibold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/edittexts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_weight="4">

            <LinearLayout
                android:id="@+id/name_et_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_shape_gray">

                <EditText
                    android:id="@+id/name_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:hint="@string/hint_user_name"
                    android:textColorHint="#9E9E9E"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/semibold"
                    android:inputType="textCapWords" />
            </LinearLayout>

            <TextView
                android:id="@+id/name_error_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Enter your name"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/other_details_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/course_select_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_bg_gray">

                    <TextView
                        android:id="@+id/course_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/hint_courses"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_weight="1"
                        android:fontFamily="@font/semibold" />

                    <ImageView
                        android:id="@+id/down_arrow_icon_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/icon_down_arrow"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/semester_select_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_bg_gray">

                    <TextView
                        android:id="@+id/semester_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/hint_semester"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_weight="1"
                        android:fontFamily="@font/semibold" />

                    <ImageView
                        android:id="@+id/down_arrow_icon_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/icon_down_arrow"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/other_details_error_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Select your course"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/email_et_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_shape_gray">

                <EditText
                    android:id="@+id/email_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:hint="@string/hint_email"
                    android:textColorHint="#9E9E9E"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/semibold"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <TextView
                android:id="@+id/email_error_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Enter your email"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/password_et_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_shape_gray">

                <EditText
                    android:id="@+id/password_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:hint="@string/hint_password"
                    android:textColorHint="#9E9E9E"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/semibold" />
            </LinearLayout>

            <TextView
                android:id="@+id/password_error_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Enter your password"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/confirm_pwd_et_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_shape_gray">

                <EditText
                    android:id="@+id/confirm_pwd_edittext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:hint="@string/hint_confirm_password"
                    android:textColorHint="#9E9E9E"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:layout_weight="1"
                    android:fontFamily="@font/semibold" />

                <ImageView
                    android:id="@+id/pwd_show_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/icon_show_password"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <TextView
                android:id="@+id/confirm_pwd_error_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Password did not match"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/signup_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="5dp"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/ripple_bg_black">

                <TextView
                    android:id="@+id/signup_btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/btn_signup"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/terms_policy_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/read_our_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read our"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/semibold" />

                <TextView
                    android:id="@+id/terms_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="3dp"
                    android:text="Terms &amp; Conditions"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/semibold"
                    android:background="@drawable/ripple_mask_only_light" />

                <TextView
                    android:id="@+id/and_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="and"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/semibold" />

                <TextView
                    android:id="@+id/privacy_policy_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="3dp"
                    android:text="Privacy Policy"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/semibold"
                    android:background="@drawable/ripple_mask_only_light" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="30dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/have_account_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Have an account \?"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/login_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:text="@string/btn_login"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="@font/semibold"
                android:background="@drawable/ripple_mask_only_light" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
