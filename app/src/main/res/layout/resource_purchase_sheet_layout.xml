<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <LinearLayout
        android:id="@+id/line"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/sheet_line_indicator"
        android:orientation="horizontal"
        android:padding="8dp" />

    <TextView
        android:id="@+id/resource_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:fontFamily="@font/bold"
        android:text=""
        android:textColor="#000000"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/meta_data_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rating_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="13dp"
            android:background="#FFF3E0"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/rating_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/medium"
                android:text=""
                android:textColor="#F57C00"
                android:textSize="12sp"
                android:translationY="1.5dp" />

            <ImageView
                android:id="@+id/rating_img"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="3dp"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_star"
                app:tint="#F57C00" />
        </LinearLayout>

        <TextView
            android:id="@+id/subject_name_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="13dp"
            android:background="#F5F5F5"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="12sp"
            android:translationY="1.0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/session_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="13dp"
            android:background="#F5F5F5"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="12sp"
            android:translationY="1.0dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/choose_payment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:fontFamily="@font/semibold"
        android:text="@string/choose_payment_method"
        android:textColor="#000000"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/radiogroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/cash_radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:text=""
            android:textColor="#000000"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/coins_radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:text=""
            android:textColor="#000000"
            android:textSize="12sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/btns_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_wishlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_wishlist"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="3dp"
                android:focusable="false"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_heart_hollow" />

            <TextView
                android:id="@+id/btn_wishlist_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="13dp"
                android:focusable="false"
                android:fontFamily="@font/medium"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/add_to_wishlist"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#000000"
            android:focusable="false"
            android:fontFamily="@font/medium"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>