<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <LinearLayout
        android:id="@+id/line"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/sheet_line_indicator"
        android:orientation="horizontal"
        android:padding="8dp" />

    <TextView
        android:id="@+id/resource_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:fontFamily="@font/bold"
        android:text=""
        android:textColor="#000000"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/resource_course"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="70dp"
        android:focusable="false"
        android:fontFamily="@font/semibold"
        android:text=""
        android:textColor="#9E9E9E"
        android:textSize="11sp" />

    <RelativeLayout
        android:id="@+id/academic_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="2dp">

        <LinearLayout
            android:id="@+id/semester_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semester_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:text="@string/hint_semester"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semester_value_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:paddingLeft="13dp"
                android:paddingTop="3dp"
                android:paddingRight="13dp"
                android:paddingBottom="3dp"
                android:text=""
                android:textColor="#757575"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/session_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@id/semester_container"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/session_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:text="@string/session"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/session_value_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:paddingLeft="13dp"
                android:paddingTop="3dp"
                android:paddingRight="13dp"
                android:paddingBottom="3dp"
                android:text=""
                android:textColor="#757575"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/subject_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:id="@+id/subject_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="20dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/subject_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:text="@string/subject"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/subject_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:paddingLeft="13dp"
                android:paddingTop="3dp"
                android:paddingRight="13dp"
                android:paddingBottom="3dp"
                android:text=""
                android:textColor="#757575"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subtype_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/subject_container"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/subtype_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:text="@string/type"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/subtype_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:focusable="false"
                android:fontFamily="@font/semibold"
                android:paddingLeft="13dp"
                android:paddingTop="3dp"
                android:paddingRight="13dp"
                android:paddingBottom="3dp"
                android:text=""
                android:textColor="#757575"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/other_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/rating_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="5dp"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:text="@string/rating"
            android:textColor="#000000"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rating_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rating_title"
            android:layout_marginEnd="25dp"
            android:background="#FFF3E0"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="3dp"
            android:paddingRight="14dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/rating_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/medium"
                android:text=""
                android:textColor="#F57C00"
                android:textSize="10sp"
                android:translationY="1.5dp"
                tools:ignore="SmallSp" />

            <ImageView
                android:id="@+id/rating_img"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="3dp"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_star"
                app:tint="#F57C00" />
        </LinearLayout>

        <TextView
            android:id="@+id/date_of_upload_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_toEndOf="@id/rating_container"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:text="@string/uploaded_on"
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/date_of_upload_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/date_of_upload_title"
            android:layout_toEndOf="@id/rating_container"
            android:background="#F5F5F5"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:paddingLeft="13dp"
            android:paddingTop="3dp"
            android:paddingRight="13dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="10sp"
            tools:ignore="SmallSp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/tags_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/best_choice_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#000000"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:text="@string/best_choice"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/recommended_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:text="@string/recommend"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            tools:ignore="SmallSp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/price_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/price_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:text="@string/price"
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cash_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/price_title"
            android:background="#F5F5F5"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:paddingLeft="13dp"
            android:paddingTop="3dp"
            android:paddingRight="13dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/slash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/price_title"
            android:layout_alignBottom="@id/cash_value"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_toEndOf="@id/cash_value"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:gravity="center_vertical"
            android:text="/"
            android:textColor="#9E9E9E"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/coins_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/price_title"
            android:layout_toEndOf="@id/slash"
            android:background="#F5F5F5"
            android:focusable="false"
            android:fontFamily="@font/semibold"
            android:paddingLeft="13dp"
            android:paddingTop="3dp"
            android:paddingRight="13dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textColor="#757575"
            android:textSize="10sp"
            tools:ignore="SmallSp" />
    </RelativeLayout>
</LinearLayout>