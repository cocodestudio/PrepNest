<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/upper_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="30dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/login_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log In"
                android:textSize="30sp"
                android:textColor="#000000"
                android:fontFamily="@font/bold" />

            <TextView
                android:id="@+id/login_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtext"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:translationY="-5.0dp"
                android:fontFamily="@font/semibold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/edittexts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_weight="4">

            <LinearLayout
                android:id="@+id/email_et_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_shape_gray">

                <EditText
                    android:id="@+id/email_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:hint="@string/hint_email"
                    android:textColorHint="#9E9E9E"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/semibold"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <TextView
                android:id="@+id/email_error_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Enter your email"
                android:textSize="10sp"
                android:textColor="#000000"
                android:fontFamily="@font/medium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/password_et_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_shape_gray">

                <EditText
                    android:id="@+id/password_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:hint="@string/hint_password"
                    android:textColorHint="#9E9E9E"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:fontFamily="@font/semibold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/forget_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/password_error_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Enter your password"
                    android:textSize="10sp"
                    android:textColor="#000000"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/forget_pass_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:paddingLeft="5dp"
                    android:paddingTop="2dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="2dp"
                    android:gravity="right"
                    android:text="Forgot Password\?"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/semibold"
                    android:background="@drawable/ripple_mask_only_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/login_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/ripple_bg_black">

                <TextView
                    android:id="@+id/login_btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/btn_login"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="30dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/not_have_account_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doesn't have an account \?"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/semibold" />

            <TextView
                android:id="@+id/signup_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:text="@string/btn_create_acc"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="@font/semibold"
                android:background="@drawable/ripple_mask_only_light" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
