<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="22dp"
                android:padding="6dp"
                android:src="@drawable/icon_back"
                android:scaleType="fitCenter"
                android:rotation="180" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:gravity="center_horizontal|center_vertical"
                android:text="Profile"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_weight="1"
                android:fontFamily="@font/semibold" />

            <ImageView
                android:id="@+id/edit_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="20dp"
                android:padding="6dp"
                android:src="@drawable/icon_edit_2"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/vscroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/profile_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/default_profile_container"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="#FAFAFA"
                        android:gravity="center_horizontal|center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/default_profile_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="AC"
                            android:textSize="25sp"
                            android:textColor="#000000"
                            android:fontFamily="@font/semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/user_profile_container"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/user_profile_picture"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/default_image"
                            app:civ_border_width="0dp"
                            app:civ_border_color="#008DCD"
                            app:civ_circle_background_color="#FFFFFF"
                            app:civ_border_overlay="true" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/change_img_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    android:text="Change profile picture"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/medium"
                    android:background="@drawable/ripple_mask_only_light"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/remove_profile_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    android:text="Remove profile"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/medium"
                    android:background="@drawable/ripple_mask_only_light"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/edittexts_container"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:paddingLeft="30dp"
                    android:paddingTop="30dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/name_et_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/rounded_shape_gray"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/name_edittext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="10dp"
                            android:paddingTop="12dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="12dp"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:text="@string/def_user_name"
                            android:textSize="12sp"
                            android:textColor="#000000"
                            android:hint="@string/hint_user_name"
                            android:textColorHint="#9E9E9E"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:fontFamily="@font/semibold"
                            android:inputType="textCapWords"
                            android:enabled="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/name_error_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Enter your name"
                        android:textSize="10sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/medium"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/other_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/course_select_container"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_shape_gray">

                            <TextView
                                android:id="@+id/course_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:text="@string/hint_courses"
                                android:textSize="12sp"
                                android:textColor="#000000"
                                android:layout_weight="1"
                                android:fontFamily="@font/semibold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/semester_select_container"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_weight="1"
                            android:background="@drawable/ripple_bg_gray">

                            <TextView
                                android:id="@+id/semester_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:text="@string/hint_semester"
                                android:textSize="12sp"
                                android:textColor="#000000"
                                android:layout_weight="1"
                                android:fontFamily="@font/semibold" />

                            <ImageView
                                android:id="@+id/down_arrow_icon_1"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginRight="10dp"
                                android:src="@drawable/icon_down_arrow"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/email_et_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/rounded_shape_gray"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/email_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="10dp"
                            android:paddingTop="12dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="12dp"
                            android:gravity="center_vertical"
                            android:text="@string/def_user_email"
                            android:textSize="12sp"
                            android:textColor="#000000"
                            android:layout_weight="1"
                            android:fontFamily="@font/semibold" />

                        <TextView
                            android:id="@+id/btn_email_verification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="4dp"
                            android:paddingLeft="6dp"
                            android:paddingTop="3dp"
                            android:paddingRight="6dp"
                            android:paddingBottom="3dp"
                            android:textSize="10sp"
                            android:textColor="#000000"
                            android:fontFamily="@font/semibold"
                            android:background="@drawable/ripple_mask_only_dark"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/phn_number_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/country_code_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/rounded_shape_gray">

                            <TextView
                                android:id="@+id/country_code_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="12dp"
                                android:paddingTop="12dp"
                                android:paddingRight="18dp"
                                android:paddingBottom="12dp"
                                android:gravity="center_vertical"
                                android:text="@string/country_code"
                                android:textSize="12sp"
                                android:textColor="#000000"
                                android:fontFamily="@font/semibold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/phn_number_et_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/rounded_shape_gray">

                            <EditText
                                android:id="@+id/phn_number_edittext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="10dp"
                                android:paddingTop="12dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="12dp"
                                android:background="@android:color/transparent"
                                android:gravity="center_vertical"
                                android:text="@string/def_user_phone"
                                android:textSize="12sp"
                                android:textColor="#000000"
                                android:hint="Phone number"
                                android:textColorHint="#9E9E9E"
                                android:singleLine="true"
                                android:inputType="phone"
                                android:imeOptions="actionDone"
                                android:layout_weight="1"
                                android:fontFamily="@font/semibold"
                                android:enabled="false" />

                            <TextView
                                android:id="@+id/btn_phone_verification"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="4dp"
                                android:paddingLeft="6dp"
                                android:paddingTop="3dp"
                                android:paddingRight="6dp"
                                android:paddingBottom="3dp"
                                android:textSize="10sp"
                                android:textColor="#000000"
                                android:fontFamily="@font/semibold"
                                android:background="@drawable/ripple_mask_only_dark"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/phn_nmber_error_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Enter your phone number"
                        android:textSize="10sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/medium"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
